PORT=4000

DB_HOST=143.198.220.117
DB_PORT=3321
DB_USER=marsys
DB_PASSWORD=isi-password-mysql
DB_NAME=marsys2

JWT_SECRET=ganti-dengan-secret-kuat-panjang
JWT_EXPIRES_IN=8h

# -- AI Assistant (9Router, OpenAI-compatible) --
# NINEROUTER_URL boleh tanpa /v1 (otomatis ditambah), contoh: http://localhost:20128
NINEROUTER_URL=http://localhost:20128
NINEROUTER_KEY=isi-api-key-9router
# AI_MODEL = nama model persis seperti di dashboard 9Router -> Providers (atau GET /v1/models)
AI_MODEL=AKU-CHAT
AI_MAX_TOKENS=1024
AI_TIMEOUT_MS=90000

AGENT_MAX_ITERATIONS=6

# -- Chat log (opsional, on = buat tabel ai_chatlog di DB Marsys2) --
CHATLOG_TABLE=off